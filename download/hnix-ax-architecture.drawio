=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-24" target="arch-22"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2. E2E 워크플로우 — 장애 한 건" id="flow"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="&lt;b style='font-size:22px'&gt;E2E 워크플로우 — 야간 배치 실패 한 건을 끝까지&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;경보 → SR → AI 분류 → 에이전트·승인 → 버튼 흐름 → 구현 명세 → AX-NAVI 수정·리뷰 → KB → 사용 현황. 번호는 E2E 점검표(README)의 단계&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="flow-2" value="모니터링 · 고객" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1760" height="110" as="geometry"/></mxCell><mxCell id="flow-3" value="PMS-X" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#139D43;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#139D43;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1760" height="150" as="geometry"/></mxCell><mxCell id="flow-4" value="AX Platform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFEBFA;strokeColor=#5B3FA0;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#5B3FA0;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1760" height="150" as="geometry"/></mxCell><mxCell id="flow-5" value="개발자 · AX-NAVI IDE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDFA;strokeColor=#1B3893;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#1B3893;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1760" height="150" as="geometry"/></mxCell><mxCell id="flow-6" value="모델" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B26A00;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#B26A00;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1760" height="110" as="geometry"/></mxCell><mxCell id="flow-7" value="&lt;b&gt;모니터링&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;배치 실패 경보 critical×2 · warning · info&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="170" y="82.0" width="160" height="86" as="geometry"/></mxCell><mxCell id="flow-8" value="&lt;b&gt;고객 포털&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;&quot;퇴사자가 함께 조회돼요&quot; SR&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="348" y="82.0" width="160" height="86" as="geometry"/></mxCell><mxCell id="flow-9" value="&lt;b&gt;① 경보 접수&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;critical → 장애(같은 경보는 하나로 ×2)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;warning → SR · info → 기록&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="170" y="192.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-10" value="&lt;b&gt;② SR 분류·배정 추천&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;후보를 PMS-X가 먼저 좁힘&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;유형·우선순위·화면·담당자 → 반영&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="348" y="192.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-11" value="&lt;b&gt;게이트웨이&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;PII 가명화 · 라우팅&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;요청 로그(본문 없음)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="348" y="342.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-12" value="&lt;b&gt;hnix-local&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;사내 로컬 모델&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#B26A00;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="348" y="645.0" width="160" height="80" as="geometry"/></mxCell><mxCell id="flow-13" value="&lt;b&gt;③ 에이전트 실행&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;SM 운영 도우미 — 실행자 권한&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;모델 → pmsx__srs → 모델&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="526" y="342.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-14" value="&lt;b&gt;④ 승인함&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;정책 'SR 상세는 승인 후'&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;책임자 승인 → 이어서 실행&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="704" y="342.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-15" value="&lt;b&gt;pmsx__sr 조회&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;허브 → 서비스 계정 JWT&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;GET 만&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="704" y="192.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-16" value="&lt;b&gt;⑤ 화면 뷰어&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;조회 버튼 → 함수·SQL·테이블&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;AI 설명 초안 · 근거 등급&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="882" y="192.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-17" value="&lt;b&gt;⑥ 구현 명세&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;요구사항·버튼 흐름·영향 테이블&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;소스 위치·테스트 항목 MD·JSON&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1060" y="192.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-18" value="&lt;b&gt;명세를 채팅에&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;/find · /impact — 색인 근거&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;허브의 pmsx__·axnavi__ 도구&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1060" y="492.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-19" value="&lt;b&gt;MCP 허브&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;axnavi__table · pmsx__impact&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;호출 감사(인자 이름·크기만)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1238" y="342.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-20" value="&lt;b&gt;⑦ 수정 → 변경 리뷰&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;STOP(인젝션) → AI로 고치기&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;→ GO · 단계 게이트 · CI 차단&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1238" y="492.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-21" value="&lt;b&gt;⑧ SR 종료 → KB 초안&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;증상·원인·처리·재발 방지&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;사람이 확인 후 등록&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1416" y="192.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-22" value="&lt;b&gt;⑨ Insight · 관측&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;호출 주체별(PMS-X·AX-NAVI·&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;에이전트·Claude Code) 사용량&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1594" y="342.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-23" value="&lt;b&gt;문서 RAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;장애 대응 중 운영 매뉴얼 검색&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;임베딩 hnix-embed(사내 로컬)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="882" y="342.0" width="160" height="126" as="geometry"/></mxCell><mxCell id="flow-24" value="웹훅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.6;fontSize=11;fontColor=#666666;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-7" target="flow-9"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.6;fontSize=11;fontColor=#666666;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-8" target="flow-10"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-26" value="llm 키" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#139D43;strokeWidth=1.6;fontSize=11;fontColor=#139D43;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-10" target="flow-11"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B26A00;strokeWidth=1.6;fontSize=11;fontColor=#B26A00;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="flow-11" target="flow-12"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-28" value="운영자가 에이전트에" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-10" target="flow-13"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-13" target="flow-14"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-30" value="승인 뒤 한 번" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-14" target="flow-15"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#139D43;strokeWidth=1.6;fontSize=11;fontColor=#139D43;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-15" target="flow-16"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#139D43;strokeWidth=1.6;fontSize=11;fontColor=#139D43;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-16" target="flow-17"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-33" value="파일 전달" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#139D43;strokeWidth=1.6;fontSize=11;fontColor=#139D43;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-17" target="flow-18"><mxGeometry x="0.3" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-34" value="/mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-18" target="flow-19"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-18" target="flow-20"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-36" value="배포 후 SR 종료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-20" target="flow-21"><mxGeometry x="0" y="" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-37" value="모든 모델 호출 계량" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-11" target="flow-22"><mxGeometry x="-0.2" y="" relative="1" as="geometry"><Array as="points"><mxPoint x="428" y="470"/><mxPoint x="1642" y="470"/></Array></mxGeometry></mxCell><mxCell id="flow-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-19" target="flow-22"><mxGeometry x="0" y="" relative="1" as="geometry"><Array as="points"><mxPoint x="1318" y="470"/><mxPoint x="1690" y="470"/></Array></mxGeometry></mxCell><mxCell id="flow-39" value="작업 요약" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-20" target="flow-22"><mxGeometry x="-0.3" y="" relative="1" as="geometry"><Array as="points"><mxPoint x="1738" y="589"/></Array></mxGeometry></mxCell><mxCell id="flow-40" value="&lt;b&gt;단계별로 확인하는 것&lt;/b&gt; (자동 점검 &lt;code&gt;npm run smoke&lt;/code&gt; 가 같은 지점을 본다)&lt;br&gt;① PMS-X 장애 목록에 경보 묶음(×2)이 보인다 · ② SR 상세의 분류·배정 추천에 모델 별칭 hnix-local, 반영하면 SR 이 바뀐다 · ③ 플랫폼 › 에이전트 실행 기록에 모델·도구 단계(span) · ④ 허브 › 승인함에 요청, 승인 뒤 같은 인자로 한 번만 실행 · ⑤ 화면 뷰어 AI 초안에 근거 등급 · ⑥ 구현 명세 MD 에 버튼 흐름·영향 테이블 · ⑦ AX-NAVI 리뷰 STOP → 수정 후 GO, 허브 호출 기록에 axnavi__/pmsx__ · ⑧ KB 초안 끝에 출처 SR · ⑨ Insight 에 pmsx · axnavi · agent · claude-code 호출이 주체별로&lt;br&gt;&lt;br&gt;&lt;b&gt;데이터·보안 원칙&lt;/b&gt; — 요청·응답 본문은 어디에도 저장하지 않는다 · 허브 호출 기록은 인자 이름·크기만 · PMS-X AI 를 끄면 외부 호출 0건 · 구독 자격은 개발자 PC 를 떠나지 않는다 · 기밀은 restricted → 사내 로컬 모델만" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="755" width="1760" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>