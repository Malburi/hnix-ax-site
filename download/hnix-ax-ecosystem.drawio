y="66"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2. 운영 워크플로우 — 장애 하나가 지식이 되기까지" id="ops"><mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ops-1" value="&lt;b style='font-size:24px'&gt;운영 워크플로우 — 새벽 경보 하나가 지식이 되기까지&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;번호는 통합 점검(E2E) 단계. 사람은 판단·승인만, 찾고·모으고·기록하는 일은 에이전트와 제품이 한다&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1400" height="50" as="geometry"/></mxCell><mxCell id="ops-2" value="&lt;font color='#5B3FA0'&gt;■&lt;/font&gt; AX Platform　&lt;font color='#139D43'&gt;■&lt;/font&gt; PMS-X　&lt;font color='#1B3893'&gt;■&lt;/font&gt; AX-NAVI　&lt;font color='#126E82'&gt;■&lt;/font&gt; AX-DataLake　&lt;font color='#B26A00'&gt;■&lt;/font&gt; 모델　&lt;font color='#8A3B12'&gt;■&lt;/font&gt; 사람　&lt;font color='#666666'&gt;■&lt;/font&gt; 고객 시스템" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1250" y="14" width="540" height="40" as="geometry"/></mxCell><mxCell id="ops-3" value="고객 · 현업" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1760" height="120" as="geometry"/></mxCell><mxCell id="ops-4" value="AX Platform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFEBFA;strokeColor=#5B3FA0;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#5B3FA0;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1760" height="150" as="geometry"/></mxCell><mxCell id="ops-5" value=