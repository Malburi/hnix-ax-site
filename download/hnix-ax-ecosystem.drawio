</Array></mxGeometry></mxCell><mxCell id="ops-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="ops-25" target="ops-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-39" value="커밋 훅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-26" target="ops-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1326.0" y="780"/></Array></mxGeometry></mxCell><mxCell id="ops-40" value="배포 · SR 종료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-26" target="ops-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1508.0" y="836"/></Array></mxGeometry></mxCell><mxCell id="ops-41" value="적재" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#139D43;strokeWidth=1.6;fontSize=11;fontColor=#139D43;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="ops-24" target="ops-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#126E82;strokeWidth=1.6;fontSize=11;fontColor=#126E82;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-19" target="ops-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#126E82;strokeWidth=1.6;fontSize=11;fontColor=#126E82;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="ops-19" target="ops-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-44" value="모든 실행·승인 기록" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-14" target="ops-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="962.0" y="196"/><mxPoint x="1599.0" y="196"/></Array></mxGeometry></mxCell><mxCell id="ops-45" value="&lt;b&gt;사람이 하는 일&lt;/b&gt; — ② 배정 확정 · ④ 진단·조치 승인(요청자는 스스로 승인 불가) · ⑦ 수정과 리뷰 판단 · ⑧ KB 확정. &lt;b&gt;제품이 하는 일&lt;/b&gt; — 경보를 장애로 묶고, 에이전트가 레이크 온톨로지에서 직전 변경을 찾고, 영향 범위를 색인으로 보이고, 커밋을 SR에 잇고, 사용량을 모은다.&lt;br&gt;&lt;br&gt;&lt;b&gt;지키는 것&lt;/b&gt; — 모델 호출은 게이트웨이(기밀은 사내 모델만) · 도구 호출은 허브(정책·승인·감사) · 데이터는 레이크 거버넌스(가림·행 제한) — 에이전트도 사람과 같은 규칙" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="895" width="1760" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. 개발 · 전환 워크플로우 — SI에서 SM으로, 레거시에서 현대화로" id="dev"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dev-1" value="&lt;b style='font-size:24px'&gt;개발 · 전환 워크플로우 — 낯선 레거시를 넘겨받아 안전하게 고치기까지&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;분석은 AI 없이 전수로(결정론), 판단은 근거와 함께, 변경은 게이트를 지나서&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1500" height="50" as="geometry"/></mxCell><mxCell id="dev-2" value="&lt;font color='#5B3FA0'&gt;■&lt;/font&gt; AX Platform　&lt;font color='#139D43'&gt;■&lt;/font&gt; PMS-X　&lt;font color='#1B3893'&gt;■&lt;/font&gt; AX-NAVI　&lt;font color='#126E82'&gt;■&lt;/font&gt; AX-DataLake　&lt;font color='#B26A00'&gt;■&lt;/font&gt; 모델　&lt;font color='#8A3B12'&gt;■&lt;/font&gt; 사람　&lt;font color='#666666'&gt;■&lt;/font&gt; 고객 시스템" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1250" y="14" width="540" height="40" as="geometry"/></mxCell><mxCell id="dev-3" value="PMS-X" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#139D43;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#139D43;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1760" height="170" as="geometry"/></mxCell><mxCell id="dev-4" value="AX-NAVI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDFA;strokeColor=#1B3893;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#1B3893;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1760" height="170" as="geometry"/></mxCell><mxCell id="dev-5" value="AX-DataLake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4F3F6;strokeColor=#126E82;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#126E82;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1760" height="150" as="geometry"/></mxCell><mxCell id="dev-6" value="AX Platform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFEBFA;strokeColor=#5B3FA0;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#5B3FA0;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1760" height="150" as="geometry"/></mxCell><mxCell id="dev-7" value="&lt;b&gt;1 수집&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;고객망 PC의 collector&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;소스·DB 메타·화면 캡처&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="150" y="95.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-8" value="&lt;b&gt;2 As-Is 분석&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;화면→버튼→함수→SQL&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;→테이블 그래프 · ERD&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="355" y="95.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-9" value="&lt;b&gt;3 인수인계&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;갭 리포트 · 준비도&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;질문 목록 · 퀴즈&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="560" y="95.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-10" value="&lt;b&gt;4 전수 색인&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;호출 그래프 · SQL 사용처&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;트랜잭션 · 데드 코드&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="355" y="275.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-11" value="&lt;b&gt;5 SDLC 산출물&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;요구 → 설계 → 개발 → 테스트&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;단계 게이트&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="765" y="275.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-12" value="&lt;b&gt;6 수정 · 현대화&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;Java 21 · jakarta&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;Oracle → PG 자동 변환&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="970" y="275.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-13" value="&lt;b&gt;7 리뷰 · 테스트&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;GO/HOLD/STOP · OWASP&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;테스트 생성 · 커버리지&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1175" y="275.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-14" value="&lt;b&gt;8 산출물 현행화&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;구현 명세 · 프로그램 대장&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;위키 · 추적성&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1380" y="95.0" width="190" height="140" as="geometry"/></mxCell><mxCell id="dev-15" value="&lt;b&gt;레거시 데이터&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;원본 DB 읽기 전용 동기화&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;Oracle · SQL Server&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#126E82;fillColor