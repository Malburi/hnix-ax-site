d="dev-26" value="자동 현행화" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-13" target="dev-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-27" value="데이터 영향" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#126E82;strokeWidth=1.6;fontSize=11;fontColor=#126E82;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-15" target="dev-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1017" y="487"/></Array></mxGeometry></mxCell><mxCell id="dev-28" value="스키마 변경" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-12" target="dev-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1117" y="440"/></Array></mxGeometry></mxCell><mxCell id="dev-29" value="모델 · 도구" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B3FA0;strokeWidth=1.6;fontSize=11;fontColor=#5B3FA0;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-17" target="dev-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-30" value="커밋 훅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B3893;strokeWidth=1.6;fontSize=11;fontColor=#1B3893;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-13" target="dev-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="395"/><mxPoint x="1395" y="615"/></Array></mxGeometry></mxCell><mxCell id="dev-31" value="&lt;b&gt;왜 다른가&lt;/b&gt; — 코드 이해는 사람이 고른 파일을 AI가 요약하는 것이 아니라 스크립트가 전수로 뽑은 그래프에서 시작한다(분석에 모델 호출 0회). 판정은 근거 파일을 요구하고, 변경은 리뷰·게이트를 지나며, 산출물은 코드에서 다시 만든다. 데이터 쪽 영향은 레이크 계보가, 인수인계 이해도는 퀴즈가 확인한다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1760" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. AI 거버넌스 — 통제 지점 넷" id="gov"><mxGraphModel dx="1800" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gov-1" value="&lt;b style='font-size:24px'&gt;AI 거버넌스 — 무엇이 AI를 쓰든, 지나는 문은 넷&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;사람·에이전트·IDE·외부 에이전트가 모두 같은 통제 지점을 지난다. 문 밖으로 새는 길(본문 저장·자격 증명 전달)은 만들지 않는다&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1500" height="50" as="geometry"/></mxCell><mxCell id="gov-2" value="&lt;b&gt;현업·운영자&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;웹 화면&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;strokeColor=#8A3B12;fillColor=#FBEDE5;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="300" height="70" as="geometry"/></mxCell><mxCell id="gov-3" value="&lt;b&gt;개발자&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;AX-NAVI IDE · Claude Code&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#E8EDFA;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="300" height="70" as="geometry"/></mxCell><mxCell id="gov-4" value="&lt;b&gt;플랫폼 에이전트&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;트리거·템플릿&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#EFEBFA;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="300" height="70" as="geometry"/></mxCell><mxCell id="gov-5" value="&lt;b&gt;PMS-X AI 보조&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;켤 때만&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#E7F6EC;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="300" height="70" as="geometry"/></mxCell><mxCell id="gov-6" value="&lt;b&gt;외부 에이전트&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;A2A · MCP 클라이언트&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#F5F5F5;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1420" y="90" width="300" height="70" as="geometry"/></mxCell><mxCell id="gov-7" value="통제 지점" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFEBFA;strokeColor=#5B3FA0;strokeWidth=1;fontStyle=1;fontSize=13;fontColor=#5B3FA0;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1760" height="330" as="geometry"/></mxCell><mxCell id="gov-8" value="&lt;b&gt;① 모델 — LLM 게이트웨이&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;가상 키 · 분당 한도 · 예산&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;한국형 PII 가명화 · 마스킹&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;데이터 등급 restricted → 사내 모델만&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;요청·응답 본문은 저장하지 않음&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=15;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="390" height="250" as="geometry"/></mxCell><mxCell id="gov-9" value="&lt;b&gt;② 도구 — MCP 허브&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;정책 allow / deny / approve&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;인자 점검 · 스키마 drift 차단&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;승인함(같은 인자 1회, 본인 승인 불가)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;호출 감사(인자 이름·크기만)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=15;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="390" height="250" as="geometry"/></mxCell><mxCell id="gov-10" value="&lt;b&gt;③ 데이터 — 레이크 거버넌스&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;SQL 구조 검사 · 테이블 권한&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;개인정보 형식별 부분 가림&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;소속 행 제한 · 액션 승인&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;누가 어느 길로 읽었나 기록&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#126E82;fillColor=#FFFFFF;fontSize=15;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="920" y="250" width="390" height="250" as="geometry"/></mxCell><mxCell id="gov-11" value="&lt;b&gt;④ 사용 — Insight · 감사&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;호출 주체별 토큰·비용&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;정책 위반 · 도구 성공률&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;전사 AI 관측(대장에 없는 AI)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;감사 로그 · 월간 보고&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=15;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1350" y="250" 