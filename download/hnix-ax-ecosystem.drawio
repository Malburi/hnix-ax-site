<mxfile host="hnix-ax" modified="2026-10-31T00:00:00Z" agent="make_ecosystem.py" version="24.7.0" type="device"><diagram name="1. AI 생태계 한눈에" id="eco"><mxGraphModel dx="1800" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="eco-1" value="&lt;b style='font-size:24px'&gt;HNIX AX — 통합 ITO AI 생태계&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;사람 여섯 역할이 제품 넷을 쓰고, 모든 AI 호출·도구 호출·데이터 조회가 한 기반(게이트웨이·허브·거버넌스)을 지난다. 고객망 안에 설치&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1200" height="50" as="geometry"/></mxCell><mxCell id="eco-2" value="&lt;font color='#5B3FA0'&gt;■&lt;/font&gt; AX Platform　&lt;font color='#139D43'&gt;■&lt;/font&gt; PMS-X　&lt;font color='#1B3893'&gt;■&lt;/font&gt; AX-NAVI　&lt;font color='#126E82'&gt;■&lt;/font&gt; AX-DataLake　&lt;font color='#B26A00'&gt;■&lt;/font&gt; 모델　&lt;font color='#8A3B12'&gt;■&lt;/font&gt; 사람　&lt;font color='#666666'&gt;■&lt;/font&gt; 고객 시스템" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1250" y="14" width="540" height="40" as="geometry"/></mxCell><mxCell id="eco-3" value="사람" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#8A3B12;fillColor=#FBEDE5;strokeWidth=2;fontColor=#8A3B12;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="220" height="880" as="geometry"/></mxCell><mxCell id="eco-4" value="&lt;b&gt;현업 · 고객&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;현업 창구 · 고객 포털&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;문의 · 요청 · 승인&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;strokeColor=#8