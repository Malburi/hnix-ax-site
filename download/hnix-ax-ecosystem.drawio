rokeColor=#666666;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="696" y="85.0" width="168" height="90" as="geometry"/></mxCell><mxCell id="ops-11" value="&lt;b&gt;⑩ 트리거&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;경보 웹훅이 경보 진단&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;에이전트를 깨움(사람 없이)&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="150" y="202.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-12" value="&lt;b&gt;게이트웨이&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;PII 가명화 · 등급 라우팅&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;본문 저장 안 함&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="332" y="202.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-13" value="&lt;b&gt;⑪ 현업 창구&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;매뉴얼·KB 근거로 답&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;같은 장애면 SR에 연결&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="696" y="202.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-14" value="&lt;b&gt;④⑫ 승인함 · 런북&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;진단 요청·조치 요청&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;다른 사람이 승인 → 실행&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="878" y="202.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-15" value="&lt;b&gt;⑬ 생산성&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;커밋 ↔ SR 연결&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;AI 관여 표시&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1242" y="202.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-16" value="&lt;b&gt;⑨⑮ Insight&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;주체별 AI 사용·비용&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;월간 보고 · 전사 AI 관측&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#5B3FA0;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1424" y="202.0" width="350" height="126" as="geometry"/></mxCell><mxCell id="ops-17" value="&lt;b&gt;사내 모델 · Claude&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;별칭으로만&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#B26A00;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="402" y="352.0" width="140" height="66" as="geometry"/></mxCell><mxCell id="ops-18" value="&lt;b&gt;⑳ 온톨로지&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;장애 → 같은 구성 요소의&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;직전 72시간 변경 2건&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#126E82;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="514" y="442.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-19" value="&lt;b&gt;⑲ 운영 데이터&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;장애·변경·SR 적재&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;AI 질문 · 계열사별 추세&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#126E82;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1424" y="442.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-20" value="&lt;b&gt;계보 · 영향 범위&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;원본이 바뀌면&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;어디까지 가나&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#126E82;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1606" y="442.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-21" value="&lt;b&gt;① 경보 접수&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;장애·SR 자동 생성&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;같은 경보는 하나로&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="150" y="592.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-22" value="&lt;b&gt;② 분류·배정 추천&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;유형·우선순위·담당자&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;사람이 확정&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="332" y="592.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-23" value="&lt;b&gt;⑤⑥ 화면 분석 · 명세&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;버튼→SQL→테이블 영향&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;구현 명세 MD·JSON&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="696" y="592.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-24" value="&lt;b&gt;⑧ SR 종료 → KB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;증상·원인·조치·재발 방지&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;사람이 확인 후 등록&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#139D43;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1424" y="592.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-25" value="&lt;b&gt;⑦ 영향 분석 · 수정&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;색인 근거 /impact&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;리뷰 STOP → 수정 → GO&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="878" y="742.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-26" value="&lt;b&gt;CI 게이트&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;머지 요청에 review·gate&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#333333'&gt;종료 코드로 차단&lt;/font&gt;" style="rounded=1;arcSize=10;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#1B3893;fillColor=#FFFFFF;fontSize=13;fontColor=#1B2340;" vertex="1" parent="1"><mxGeometry x="1060" y="742.0" width="168" height="126" as="geometry"/></mxCell><mxCell id="ops-27" value="웹훅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.6;fontSize=11;fontColor=#666666;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="ops-9" target="ops-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-28" value="웹훅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.6;fontSize=11;fontColor=#666666;labelBackgrou